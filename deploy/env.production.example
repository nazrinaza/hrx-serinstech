# Production settings for hr.serinstech.com (cPanel).
# On the server: copy this file to ~/hrx/.env, then fill in every value marked ← CHANGE.
# Never commit the real .env.

APP_NAME="Serinstech HR"
APP_ENV=production
# Left empty: filled by  php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://hr.serinstech.com
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# ← CHANGE: cPanel → MySQL® Databases. cPanel prefixes names with your account, e.g. abc123_hrx.
# Wrap the password in double quotes if it contains spaces or # characters.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email is sent through Resend (resend.com).
# ← CHANGE RESEND_API_KEY: Resend dashboard → API Keys → Create (permission: Sending access).
# MAIL_FROM_ADDRESS must be on a domain verified in Resend (see deploy/CPANEL-GUIDE.md).
MAIL_MAILER=resend
RESEND_API_KEY=CHANGE_ME
MAIL_FROM_ADDRESS="hr@serinstech.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
